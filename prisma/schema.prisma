generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Entry {
  id            String   @id @default(cuid())
  date          String
  timeOfDay     String   @default("morning")
  mood          Int
  energy        Int
  activityLevel Int      @default(0)
  sleepHours    Float    @default(0)
  waterLevel    String   @default("")
  stress        Int      @default(0)
  note          String?
  journal       String?
  loggedAt      DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  activities    EntryActivity[]

  @@unique([date, timeOfDay])
}

model Activity {
  id   String @id @default(cuid())
  name String @unique

  entries EntryActivity[]
}

model EntryActivity {
  entryId    String
  activityId String
  entry      Entry    @relation(fields: [entryId], references: [id], onDelete: Cascade)
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@id([entryId, activityId])
}

model Habit {
  id    String @id @default(cuid())
  name  String @unique
  icon  String
  color String

  completions HabitCompletion[]
}

model HabitCompletion {
  id        String  @id @default(cuid())
  habitId   String
  date      String
  completed Boolean @default(false)
  habit     Habit   @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
}
